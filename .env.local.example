# WhatsApp Cloud API credentials
# Found in Meta App Dashboard > WhatsApp > API Setup
ACCESS_TOKEN=
PHONE_NUMBER_ID=

# Webhook verification token — any string you choose
# Must match what you enter in Meta App Dashboard > Webhooks > Verify Token
WEBHOOK_VERIFY_TOKEN=

# App Secret — Meta App Dashboard > App Settings > Basic > App Secret
# Used to verify X-Hub-Signature-256 (warning-only in this tool)
APP_SECRET=

# Upstash Redis — https://upstash.com (free tier)
# Create a database, copy the REST URL and token from the console
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
